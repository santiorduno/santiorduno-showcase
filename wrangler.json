{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "santiorduno-showcase",
  "compatibility_date": "2025-04-01",
  "main": "worker/index.ts",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS"
  },
  "routes": [
    {
      "pattern": "santiorduno.com",
      "zone_name": "santiorduno.com",
      "custom_domain": true
    },
    {
      "pattern": "www.santiorduno.com",
      "zone_name": "santiorduno.com",
      "custom_domain": true
    }
  ],
  "observability": {
    "logs": {
      "enabled": false,
      "invocation_logs": true
    }
  },
  "d1_databases": [
    {
      "binding": "santiorduno_analytics",
      "database_name": "santiorduno-analytics",
      "database_id": "53c59c61-dca4-4249-998c-3e2727fe14e1"
    }
  ]
}
